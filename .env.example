# MayaCardio Environment Configuration

# Device Settings
DEVICE_ID=bedside-rpi4-01
DEVICE_SQLITE_PATH=./data/maya_device.db
MOCK_HOST=127.0.0.1
MOCK_PORT=7100
COLLECTOR_POLL_INTERVAL_MS=100
COLLECTOR_TIMEOUT_MS=3000

# Cloud Settings
CLOUD_API_HOST=0.0.0.0
CLOUD_API_PORT=8080
CLOUD_API_URL=http://127.0.0.1:8080
CLOUD_API_KEY=mayacardio-edge-secret-token-2026

# Cloud Database (PostgreSQL)
# For local development or CI, a local postgres or mock PG container can be used.
DATABASE_URL=postgresql://mayacardio:mayapass@localhost:5432/mayacardio_db

# Mode & Sync Settings
SYNC_BATCH_SIZE=1000
SYNC_INTERVAL_MS=500
HEALTH_CHECK_INTERVAL_MS=2000
OFFLINE_PROCESSING_INTERVAL_MS=1000

# Logging
LOG_LEVEL=info
